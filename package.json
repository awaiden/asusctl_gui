{
  "name": "asusctl_gui",
  "version": "0.2.0",
  "description": "Desktop control panel for ASUS Linux laptops powered by asusctl",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "i18n:gen": "dialex generate",
    "i18n:check": "dialex check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/svelte": "^1.81.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@ui-sdk/core": "^0.1.0-beta.17",
    "@ui-sdk/svelte": "^0.1.0-beta.17",
    "dialexjs": "^0.9.3",
    "tailwind-variants": "^4.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  }
}
